  {
    "id": "n0002",
    "type": "function",
    "name": "a parámetros SQL (lectura)",
    "func": "const t = msg.topic.replace('udb-aco941/lv220238/casa/', '');\nconst v = parseFloat(msg.payload);\nif (isNaN(v)) return null;\nmsg.params = [t, v];\nreturn msg;",
    "outputs": 1,
    "wires": [
      [
        "n0001"
      ]
    ],
    "z": "tab_domotica",
    "x": 680,
    "y": 40
  },
  {
    "id": "n0001",
    "type": "postgresql",
    "name": "INSERT lecturas",
    "query": "INSERT INTO lecturas (sensor, valor) VALUES ($1, $2);",
    "postgreSQLConfig": "pg_domotica",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "wires": [
      []
    ],
    "z": "tab_domotica",
    "x": 940,
    "y": 40
  },
  {
    "id": "n0004",
    "type": "function",
    "name": "a parámetros SQL (evento)",
    "func": "// tópico: .../zona/actuador/estado  o  .../alarma/estado\nconst t = msg.topic.replace('udb-aco941/lv220238/casa/', '').replace(/\\/estado$/, '');\nmsg.params = [t, String(msg.payload)];\nreturn msg;",
    "outputs": 1,
    "wires": [
      [
        "n0003"
      ]
    ],
    "z": "tab_domotica",
    "x": 680,
    "y": 100
  },
